---

interface Props {
    title: string;
    href: string;
    image?: { src: string, alt?: string };
}

const { title, href, image } = Astro.props as Props; 
---

<a
    class="block w-full flex flex-col items-center justify-center group"
    data-astro-prefetch
    href={href}
    title={title}
>
    { image &&
        <div class="w-full aspect-[9/8] bg-white group-hover:rotate-6 transitions-all duration-200 ease-in-out" style={`background-image: url(${image.src}); background-size: cover; background-position: center;`} />
    }
    <div class="w-full relative flex justify-center">
        <div class="absolute z-[-1] inset-0 bg-black opacity-50"></div>
        <p class="text-5xl cardo-bold text-indigo-400 text-outline group-hover:brightness-125"> {title} </p>
    </div>
</a>