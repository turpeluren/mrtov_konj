---
import { Image } from 'astro:assets';
import horse from '../assets/mrtov_konj-logo.png';

const url = new URL(Astro.request.url);

const navItems = [
  { href: '/', mk: 'АРТИСТИ', en: 'ARTISTS' },
  { href: '/news/', mk: 'НОВОСТИ', en: 'NEWS' },
  { href: '/shop/', mk: 'КУПИ', en: 'SHOP' },
  { href: '/archive/', mk: 'АРХИВА', en: 'ARCHIVE' },
  { href: '/support/', mk: 'ПОДДРЖИ нè', en: 'SUPPORT', button: true }
];

const baseNavClass = 'text-lg text-white flex flex-col items-center leading-4 hover:text-gray-300';
const buttonNavClass = 'text-lg text-black bg-cyan-200 rounded-full px-4 py-0.5 flex flex-col items-center leading-4 hover:bg-cyan-300 hover:text-gray-900';
---

<div class="h-24 px-8 relative flex items-center justify-between">
    <div class="absolute z-[-1] inset-0 w-full h-full bg-black opacity-0"></div>
    <div class="absolute z-[-1] inset-0 top-[-80%] left-[-50%] w-[200%] h-[200%] bg-black opacity-70 blur-2xl"></div>
    <a href="/" class="group">
        <span class="text-2xl text-white dela-gothic-one-regular text-outline leading-3">МРТОВ<br>КОЊ</span>
        <span class="ml-1 hidden lg:inline-block text-[0.6rem] leading-2 px-1 py-0.5 bg-red-400 rounded-r-md rounded-bl-md mr-1.5 group-hover:mr-0 group-hover:ml-1.5 group-hover:pl-2 group-hover:rounded-bl-2xl transition-all ease-in-out">ГОЛА ПЛАНИНА <br> КОЛЕКТИВ</span>
    </a>
    <nav class="">
        <ul class="self-center justify-self-center flex space-x-24 items-center">
            {navItems.map((item) => {
                const isActive = url.pathname === item.href || (item.href !== '/' && url.pathname.startsWith(item.href)) || (item.href === '/' && url.pathname.startsWith('/artists/'));
                return (
                    <li>
                        <a
                            href={item.href}
                            class:list={[
                            item.button ? buttonNavClass : baseNavClass,
                            {
                                'text-yellow-400 hover:text-yellow-600': isActive && !item.button,
                                'text-yellow-400 hover:text-yellow-200 bg-cyan-600 hover:bg-cyan-700': isActive && item.button
                            }
                            ]}
                        >
                            <p>{item.mk}</p>
                            <p>{item.en}</p>
                        </a>
                    </li>
                );
            })}
        </ul>
    </nav>
    <Image src={horse} alt="Мртов Коњ" class="h-14 w-24 object-contain" />
</div>