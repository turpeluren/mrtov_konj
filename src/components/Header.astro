---
import { Image } from 'astro:assets';
import horse from '../assets/mrtov_konj-logo.png';

const url = new URL(Astro.request.url);

const navItems : { href: string; mk: string; en: string; button?: boolean }[] = [
  { href: '/', mk: 'НАСТАНИ', en: 'EVENTS' },
  { href: '/artists/', mk: 'АРТИСТИ', en: 'ARTISTS' },
  /*{ href: '/shop/', mk: 'КУПИ', en: 'SHOP' },*/
  { href: '/archive/', mk: 'АРХИВА', en: 'ARCHIVE' },
  /*{ href: '/support/', mk: 'ПОДДРЖИ нè', en: 'SUPPORT', button: true }*/
];

const baseNavClass = 'text-2xl lg:text-lg text-white flex flex-col items-center leading-6 lg:leading-4 hover:text-gray-300';
const buttonNavClass = 'text-2xl lg:text-lg text-black bg-cyan-200 rounded-full px-4 py-0.5 flex flex-col items-center leading-6 lg:leading-4 hover:bg-cyan-300 hover:text-gray-900';
---
<style>
    .translate-blur {
        transform: translateY(-20%) !important;
    }
</style>
<div class=`relative flex flex-wrap items-center lg:items-start justify-between gap-2 px-6 pt-6 pb-12 lg:mb-8 lg:h-24 lg:items-start lg:px-6 lg:pb-0``>
    <!-- Background blur -->
    <div class="pointer-events-none absolute h-full inset-0 -z-1 left-0 top-0 overflow-x-clip pb-12 lg:pb-8">
        <div id="header-bg-blur" class="-translate-y-12 h-[150%] translate-x-[-25%] w-[200%] bg-black opacity-70 blur-xl lg:blur-2xl lg:left-[-50%] lg:w-[200%]"></div>
    </div>

    <!-- Logo -->
    <a href="/" class="group order-2 lg:w-48">
        <span class="text-2xl text-white dela-gothic-one-regular text-outline leading-3">МРТОВ<br>КОЊ</span>
        <span class="ml-1 mr-1.5 hidden lg:inline-block text-[0.6rem] leading-2 px-1 py-0.5 bg-red-400 rounded-r-md rounded-bl-md group-hover:mr-0 group-hover:ml-1.5 group-hover:pl-2 group-hover:rounded-bl-2xl transition-all ease-in-out">ГОЛА ПЛАНИНА <br> КОЛЕКТИВ</span>
    </a>

    <!-- Nav -->
    <nav id="nav" class="order-6 mt-12 mb-12 hidden w-full self-start justify-self-center lg:order-4 lg:mt-0 lg:mb-0 lg:block lg:w-auto lg:self-auto">
        <ul class="flex flex-col items-center justify-center space-y-8 lg:flex-row lg:space-x-12 lg:space-y-0 xl:space-x-24">
            {navItems.map((item) => {
                const isActive = url.pathname === item.href || (item.href !== '/' && url.pathname.startsWith(item.href)) || (item.href === '/' && url.pathname.startsWith('/events/'));
                return (
                    <li>
                        <a
                            href={item.href}
                            class:list={[
                            item.button ? buttonNavClass : baseNavClass,
                            {
                                'text-yellow-400 hover:text-yellow-600': isActive && !item.button,
                                'text-yellow-400 hover:text-yellow-200 bg-cyan-600 hover:bg-cyan-700': isActive && item.button
                            }
                            ]}
                        >
                            <p>{item.mk}</p>
                            <p>{item.en}</p>
                        </a>
                    </li>
                );
            })}
        </ul>
    </nav>

    <!-- Horse logo -->
    <a href="/" class="order-4 hidden h-12 w-48 lg:flex lg:justify-end">
        <Image src={horse} alt="Мртов Коњ" class="w-auto h-full object-contain" />
    </a>

    <!-- Hamburger menu -->
    <div id="hamburger" class="group order-5 flex justify-end lg:hidden relative">
        <button class="w-9 h-9 flex flex-col justify-between py-[0.1rem] cursor-pointer"
            onclick="toggleNav()"
        >
        </button>
        <div class="absolute z-[-1] top-1 left-0 h-1 w-9 bg-white group-hover:bg-gray-300 group-[.active]:h-0 transitions-all duration-100"></div>
        <div class="absolute z-[-1] top-4 left-0 h-1 w-9 bg-white group-hover:bg-gray-300 group-[.active]:rotate-45 transitions-all duration-100"></div>
        <div class="absolute z-[-1] top-7 left-0 h-1 w-9 bg-white group-hover:bg-gray-300 group-[.active]:h-0 transitions-all duration-100"></div>
        <div class="absolute z-[-1] top-4 right-4 group-[.active]:right-0 w-0 group-[.active]:w-9 h-1 bg-white group-hover:bg-gray-300 group-[.active]:block group-[.active]:-rotate-45 transitions-all duration-100"></div>
    </div>
</div>

<script is:inline>
    function toggleNav() {
        document?.getElementById('nav')?.classList.toggle('hidden');
        document?.getElementById('hamburger')?.classList.toggle('active');
        document?.getElementById('header-bg-blur')?.classList.toggle('translate-blur');
        document?.getElementById('hero')?.classList.toggle('absolute');
        document?.getElementById('hero-height-fixer')?.classList.toggle('hidden');
    }
</script>