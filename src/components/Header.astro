---
import { Image } from 'astro:assets';
import horse from '../assets/mrtov_konj-logo.png';

const url = new URL(Astro.request.url);

const navItems = [
  { href: '/', mk: 'АРТИСТИ', en: 'ARTISTS' },
  { href: '/news/', mk: 'НОВОСТИ', en: 'NEWS' },
  { href: '/shop/', mk: 'КУПИ', en: 'SHOP' },
  { href: '/archive/', mk: 'АРХИВА', en: 'ARCHIVE' },
  { href: '/support/', mk: 'ПОДДРЖИ нè', en: 'SUPPORT', button: true }
];

const baseNavClass = 'text-2xl lg:text-lg text-white flex flex-col items-center leading-6 lg:leading-4 hover:text-gray-300';
const buttonNavClass = 'text-2xl lg:text-lg text-black bg-cyan-200 rounded-full px-4 py-0.5 flex flex-col items-center leading-6 lg:leading-4 hover:bg-cyan-300 hover:text-gray-900';
---

<div class="relative flex flex-wrap items-start justify-between gap-2 px-6 pt-6 pb-4 lg:h-24 lg:items-center lg:px-6 lg:py-0">
    <!-- Background blur -->
    <div class="order-1 inset-0 absolute -z-1 top-[-80%] h-[200%] w-full bg-black opacity-70 blur-2xl lg:left-[-50%] lg:w-[200%]"></div>

    <!-- Logo -->
    <a href="/" class="group order-2 lg:w-auto">
        <span class="text-2xl text-white dela-gothic-one-regular text-outline leading-3">МРТОВ<br>КОЊ</span>
        <span class="ml-1 hidden lg:inline-block text-[0.6rem] leading-2 px-1 py-0.5 bg-red-400 rounded-r-md rounded-bl-md group-hover:mr-0 group-hover:ml-1.5 group-hover:pl-2 group-hover:rounded-bl-2xl transition-all ease-in-out">ГОЛА ПЛАНИНА <br> КОЛЕКТИВ</span>
    </a>

    <!-- Nav -->
    <nav id="nav" class="order-3 mt-12 mb-12 hidden w-full self-start lg:order-4 lg:mt-0 lg:mb-0 lg:block lg:w-auto lg:self-auto">
        <ul class="flex flex-col items-center justify-center space-y-8 lg:flex-row lg:space-x-12 lg:space-y-0 xl:space-x-24">
            {navItems.map((item) => {
                const isActive = url.pathname === item.href || (item.href !== '/' && url.pathname.startsWith(item.href)) || (item.href === '/' && url.pathname.startsWith('/artists/'));
                return (
                    <li>
                        <a
                            href={item.href}
                            class:list={[
                            item.button ? buttonNavClass : baseNavClass,
                            {
                                'text-yellow-400 hover:text-yellow-600': isActive && !item.button,
                                'text-yellow-400 hover:text-yellow-200 bg-cyan-600 hover:bg-cyan-700': isActive && item.button
                            }
                            ]}
                        >
                            <p>{item.mk}</p>
                            <p>{item.en}</p>
                        </a>
                    </li>
                );
            })}
        </ul>
    </nav>

    <!-- Horse logo -->
    <Image src={horse} alt="Мртов Коњ" class="order-4 hidden h-14 w-24 object-contain lg:block" />

    <!-- Hamburger menu -->
    <div id="hamburger" class="group order-5 flex justify-end lg:hidden relative">
        <button class="w-9 h-9 grid grid-cols-1 grid-rows-3 gap-y-3 cursor-pointer group-[.active]:rotate-45 transitions-all duration-100"
            onclick="toggleNav()"
        >
            <div class="bg-white group-hover:bg-gray-300 group-[.active]:opacity-0"></div>
            <div class="bg-white group-hover:bg-gray-300"></div>
            <div class="bg-white group-hover:bg-gray-300 group-[.active]:opacity-0"></div>
        </button>
        <div class="absolute z-[-1] top-4 right-4 group-[.active]:right-0 w-0 group-[.active]:w-9 h-1 bg-white group-hover:bg-gray-300  group-[.active]:block group-[.active]:-rotate-45 transitions-all duration-100"></div>
    </div>
</div>

<script is:inline>
    function toggleNav() {
        document?.getElementById('nav')?.classList.toggle('hidden');
        document?.getElementById('hamburger')?.classList.toggle('active');
    }
</script>