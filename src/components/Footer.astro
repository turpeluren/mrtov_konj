---
import SocialLink from "./SocialLink.astro";

import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();

const links = {
    bandcamp: "https://mrtovkonj.bandcamp.com/",
    instagram: "https://www.instagram.com/mrtov_konj/",
    youtube: "https://www.youtube.com/@mrtovkonjrecords",
    facebook: "https://www.facebook.com/profile.php?id=61557186780927",
};
---

<div class="w-full relative overflow-hidden pt-20">
    <!-- Background blur -->
    <!--div class="order-1 inset-0 absolute -z-1 left-0 top-0 translate-y-24 h-[150] w-full bg-black opacity-70 blur-2xl lg:left-[-50%] lg:w-[200%]"></div>
    -->
    <div class="pointer-events-none absolute h-full inset-0 -z-1 left-0 bottom-0 overflow-x-clip pt-12">
        <div id="bg-blur" class="translate-y-12 h-[150%] translate-x-[-25%] w-[200%] bg-black opacity-70 blur-xl lg:blur-2xl lg:left-[-50%] lg:w-[200%]"></div>
    </div>

    <footer
        class="w-full flex flex-col items-center justify-center text-center gap-y-2 py-4 text-white"
    >
        <div class="flex flex-col items-end">
            <nav
                aria-label="Socials"
                class="flex gap-x-3"
            >
                { links.bandcamp && ( 
                    <SocialLink href={links.bandcamp} icon="simple-icons:bandcamp" />
                )}
                { links.instagram && (
                    <SocialLink href={links.instagram} icon="simple-icons:instagram" />
                )}
                { links.youtube && (
                    <SocialLink href={links.youtube} icon="simple-icons:youtube" />
                )}
                { links.facebook && (
                    <SocialLink href={links.facebook} icon="simple-icons:facebook" />
                )}
            </nav>
        </div>
        <div class="text-center sm:text-left">
            &copy; Mrtov Konj {year}.
            <!--span class="inline-block">sida av <a class="text-link underline sm:no-underline hover:underline" href="https://turpelurpeluren.online">turpelurpeluren</a>.</span-->
        </div>
    </footer>
</div>