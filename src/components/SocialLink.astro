---
import { Icon } from "astro-icon/components";

const { href, icon } = Astro.props as { href: string; icon: string };
---

<a href={href} class="hover:underline hover:brightness-75 bg-black rounded-full p-3" target="_blank" rel="noopener noreferrer"><Icon class="inline-block w-8 h-8" name={icon}/></a>
