---

interface Props {
    title: string;
    tooltip?: string;
    href: string;
    image?: { src: string, alt?: string };
    font?: string;
    color?: string;
    topText?: boolean;
    rotationAmount?: -8 | 0  | 8 | 35;
}

const { title, tooltip, href, image, font, color, topText=false, rotationAmount=4 } = Astro.props as Props; 

const textSize = font == 'katibeh-regular' ? 'text-5xl' : 'text-4xl';

// Calculate how light the text color is to determine if we should use black or white outline
function getContrastYIQ(hexcolor: string) {
    hexcolor = hexcolor.replace("#", "");
    const r = parseInt(hexcolor.substr(0, 2), 16);
    const g = parseInt(hexcolor.substr(2, 2), 16);
    const b = parseInt(hexcolor.substr(4, 2), 16);
    const yiq = (r * 299 + g * 587 + b * 114) / 1000;
    return yiq >= 20 ? 'text-outline-2' : 'text-outline-white';
}

const outlineColor = color ? getContrastYIQ(color) : 'text-outline-2';
---
{/* Script to fix some artists texts overflowing the container width */}
<script is:inline define:vars={{title}}>
    document.addEventListener('DOMContentLoaded', () => {
        const artistName = document.getElementById(`artistName-${title}`);
        const background = document.getElementById(`background-${title}`);
        const overflowCenterer = document.getElementById(`overflowCenterer-${title}`);
        if (artistName && background) {
            const nameWidth = overflowCenterer.getBoundingClientRect().width;
            const backgroundWidth = background.getBoundingClientRect().width;
            if (nameWidth >= backgroundWidth) {
                overflowCenterer.classList.add('ml-[-100px]');
                overflowCenterer.classList.add('mr-[-100px]');
            }
        }
    });
</script>

<a
    class="w-full flex flex-col items-center justify-center group"
    data-astro-prefetch
    href={href}
    title={tooltip ? tooltip : title}
>
    <div class="w-full h-full aspect-9/8 group relative transform-3d perspective-distant lg:perspective-normal hover:z-10">
        <div id={`background-${title}`} class={`w-full h-full inset-0 flex justify-center bg-white group-hover:scale-101 ${rotationAmount === 8 ? 'group-hover:rotate-y-8' : rotationAmount === -8 ? 'group-hover:-rotate-y-8' : rotationAmount == 35 ? 'group-hover:rotate-y-35' : 'group-hover:rotate-y-0'} group-hover:-rotate-x-12 transform-3d transitions-all duration-500 ease-in-out`} 
            style={`background-image: url(${image?.src}); background-size: cover; background-position: center;`}>
            <p id={`artistName-${title}`} class={`${textSize} text-center leading-7 max-w-[80%] ${font ? font : 'dela-gothic-one-regular'} ${topText ? 'self-start' : 'self-end'} text-indigo-400 text-center ${outlineColor} group-hover:rotate-z-0 translate-z-24 ${topText ? 'translate-y-8' : '-translate-y-8'} transform-3d group-hover:brightness-125 transitions-all duration-200`}
                style={`${color && `color: ${color};`}`}
            ><span id={`overflowCenterer-${title}`} class="">{title}</span></p>
        </div>
    </div>
</a>