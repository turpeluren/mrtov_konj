---
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import heroImage from '../assets/bg-shop.png';

const { title, hero=false, bgImage, bgOffsetX, bgOffsetY, bgRotation, bgSize } = Astro.props;

interface Props {
    title?: string;
    hero?: boolean;
    bgImage?: { src: string };
    bgOffsetX?: number; // %
    bgOffsetY?: number; // %
    bgRotation?: number; // deg
    bgSize?: number; // %
}
---

<!doctype html>
<html lang="en">
    <style>
        @media (max-width: 1024px) {
            .bg-mobile {
                width: 100% !important;
                height: 100% !important;
                left: 0 !important;
                top: 0 !important;
                transform: none !important;
                background-position: center center !important;
                background-size: cover !important;
            }

            .body-bg {
                /* Using the image as a background on the body for mobile devices */
                /* CSS set inline in the body tag */
            }
        }
        @media (min-width: 1024px) {
            .body-bg {
                background: #000 !important;
            }
        }
    </style>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="icon" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>Mrtov Konj</title>

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=Comic+Neue:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Dela+Gothic+One&family=Katibeh&family=Leckerli+One&family=Racing+Sans+One&family=Readex+Pro:wght@160..700&display=swap" rel="stylesheet">

        <!-- Netlify identity widget -->
        <script type="text/javascript" src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    </head>
    <body class="body-bg min-h-screen flex flex-col relative m-0 overflow-x-clip bg-opacity-70" style={bgImage ? `background: #000 url(${bgImage.src}) center / cover no-repeat fixed` : 'background: #000'}>
        <div class="pointer-events-none fixed inset-0 z-[-1] min-h-[100dvh] overflow-hidden bg-black/30">
            <div
                class={`bg-mobile hidden lg:block absolute pointer-events-none z-[-1] inset-0 overflow-hidden bg-contain min-h-[100dvh] brightness-70`}
                style={`
                    ${ bgSize ? `width: ${bgSize}vw; height: ${bgSize}vw; left: -${bgSize/(100/(bgOffsetX || 50))}vw; top: -${bgSize/(bgOffsetY ? 100/bgOffsetY : 0)}vw;` : 'width: 100%; height: 100%;'}
                    ${ bgImage ? `background-image: url(${bgImage.src}); ` : ''}
                    ${`background-position: ${bgOffsetX || 50}% ${bgOffsetY || 0}%; `}
                    ${`background-size: ${bgSize ? `${bgSize}vw` : 'contain'}; `}
                    ${ bgRotation ? `transform: rotate(${bgRotation}deg);` : ''}
                `}
            />
        </div>
        <Header />
        <!-- Hero Section -->
        { hero && (
            <style>
                .hero-height {
                    height: calc(100dvh - 6rem); /* Header is always h-32 aka 8rem */
                }
            </style>
            <div id="hero" class="hero-height absolute top-24 w-full flex flex-col mb-8">
                <div class="flex-1 flex flex-col items-center justify-center bg-cover bg-center px-4" style={`background-image: url(${heroImage.src})`}>
                    <h1 class="text-center text-4xl lg:text-6xl dela-gothic-one-regular /text-outline /font-outline-2">{title}</h1>
                    <p class="text-center text-2xl text-white">
                        МРТОВ КОЊ [ˈmr̩tɔf ˈkɔɲa] is an independent collective and label based in Skopje, Macedonia.
                    </p>
                </div>
            </div>
            <div id="hero-height-fixer" class="hero-height mb-8"></div>
        )}
        <div class="flex-1 w-full max-w-6xl mx-auto px-4 pt-0 pb-0">
            { (title && !hero) && 
                <h1 class="text-center text-4xl lg:text-6xl dela-gothic-one-regular /text-outline /font-outline-2">{title}</h1>
            }
            <slot />
        </div>
        <Footer />
    </body>
</html>
