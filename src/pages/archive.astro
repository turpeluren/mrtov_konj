---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';

import { type CollectionEntry, getCollection} from "astro:content";

const allEvents: CollectionEntry<"events">[] = await getCollection("events");
---

<script is:inline>
    // Run on body load
    document.addEventListener('DOMContentLoaded', () => {
        // Filter events that are older than todays date, at runtime, not build time
        const archiveContainer = document.getElementById('archiveContainer');
        var removeChildren = [];
        for (const element of archiveContainer.children) {
            const eventsDate = new Date(element.id);
            if (eventsDate > new Date(new Date().toDateString())) {
                removeChildren.push(element);
            }
        }
        for (const element of removeChildren) {
            //archiveContainer.removeChild(element);
            element.classList.add("hidden");
        }
        archiveContainer.classList.remove("hidden");
        if (archiveContainer.children.length === 0) {
            // If there are no upcoming events, show a message
            const noEventsMessage = document.createElement('p');
            noEventsMessage.textContent = "Нема архивирани настани / No archived events";
            noEventsMessage.classList.add("text-center", "text-xl", "text-white", "mt-8");
            archiveContainer.appendChild(noEventsMessage);
        }
    });
</script>

<Layout title="АРХИВА / ARCHIVE">
    <div id="archiveContainer" class="hidden flex flex-col gap-4 mt-8">
        {
            allEvents.sort((a, b) => {
                if (a.data.date && b.data.date) {
                    return b.data.date.getTime() - a.data.date.getTime();
                }
                return 0;
            }).map(({ data, id }) => (
                <div id={data.date?.toString()}>
                    <EventCard
                        title={data.title}
                        date={data.date}
                        description={data.description}
                        location={data.location}
                        image={data.images?.[0]}
                        href={`/events/${id}/`}
                    />
                </div>
            ))
        }
    </div>
</Layout>