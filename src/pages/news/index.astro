---
import Layout from '../../layouts/Layout.astro';
import GridCard from '../../components/GridCard.astro';

import { type CollectionEntry, getCollection} from "astro:content";

const allNews: CollectionEntry<"news">[] = await getCollection("news");
---

<Layout>
    <h1 class="text-center text-6xl dela-gothic-one-regular /text-outline /font-outline-2">НОВОСТИ / NEWS</h1>
	<div class="grid grid-cols-3 gap-4 mt-8">
		{
			allNews.map(({ data, id }) => (
				<GridCard
                    title={data.title}
                    image={data.images?.[0]}
                    href={`/news/${id}/`}
                />
			))
		}
	</div>
</Layout>