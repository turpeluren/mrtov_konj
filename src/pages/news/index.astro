---
import Layout from '../../layouts/Layout.astro';
import GridCard from '../../components/GridCard.astro';

import { type CollectionEntry, getCollection} from "astro:content";

import bgImage from '../../assets/bg-news.png';

const allNews: CollectionEntry<"news">[] = await getCollection("news");
---

<Layout bgImage={bgImage} title="НОВОСТИ / NEWS">
	<div class="grid grid-cols-3 gap-4 mt-8">
		{
			allNews.map(({ data, id }) => (
				<GridCard
                    title={data.title}
                    image={data.images?.[0]}
                    href={`/news/${id}/`}
                />
			))
		}
	</div>
</Layout>