---
import Layout from '../../../layouts/Layout.astro';
import { Icon } from "astro-icon/components";

import type { GetStaticPaths } from "astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

export const getStaticPaths: GetStaticPaths = (async () => {
    const allNews = await getCollection("news");

    return allNews.map((news) => ({
        params: {
            slug: news.id,
        },
        props: { news },
    }));
}) satisfies GetStaticPaths;

interface Props {
    news: CollectionEntry<"news">;
}

const { news } = Astro.props as Props;
const { title, date, location, images } = news.data;
const { Content } = await render(news);

---

<Layout>
    <h1>{title}</h1>
    <!-- Header with date, location -->
    { (date || location) && (
        <div class="flex flex-row items-start justify-start gap-3 text-xl text-black text-center pl-4 pr-12 py-3 bg-indigo-400">
            {date && (
                <p class="flex items-center">
                    <Icon name="pixelarticons:calendar-2" class="inline-block mr-2"/>
                    {date.toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric'
                    })}
                    {location && (
                        <span>,</span>
                    )}
                </p>
            )}

            {location && (
                <p class="flex items-center">
                    <Icon name="pixelarticons:gps-2" class="inline-block mr-2"/>
                    {location}
                </p>
            )}
        </div>
    )}
    <!-- Cover image -->
    {images && images.length > 0 && (
        <div class="w-full aspect-video mb-4">
            <img src={images[0].src} alt={images[0].description} class="mb-4 w-full object-cover" />
        </div>
    )}

    <!-- Event details article -->
    <article class="prose">
        <Content />
    </article>

    <!-- Archive images -->
    {images && images.length > 1 && (
        <h1 class="mt-4">Image archive</h1>
        <div class="w-full aspect-video mb-4">
            {
                images.slice(1).map((image : { src: string; description?: string; photographer?: string; date?: Date }, index) => (
                    <figure>
                        <img src={image.src} alt={image.description ?? ''} class="w-full object-cover" />
                        { (image.photographer || image.description) && (
                            <figcaption class="text-white">
                                {image.photographer && (<span>Photo: {image.photographer}</span>)}
                                {image.description && (<p>{image.description}</p>)}
                            </figcaption>
                        )}
                    </figure>
                ))
            }
        </div>
    )}
</Layout>
