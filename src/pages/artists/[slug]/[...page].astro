---
import Layout from '../../../layouts/Layout.astro';

import type { GetStaticPaths } from "astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

export const getStaticPaths: GetStaticPaths = async () => {
	const allBios = await getCollection("bios");

	return allBios.map((bio) => ({
		params: {
			slug: bio.id,
		},
		props: { bio },
	}));
};

interface Props {
	bio: CollectionEntry<"bios">;
}

const { bio } = Astro.props as Props;
const { name, genre, links, albums, video, photo, background }  = bio.data;
const { Content } = await render(bio);
---

<Layout title={name} bgImage={background} bgOffsetX={background?.offsetX ?? 50} bgOffsetY={background?.offsetY ?? 0} bgRotation={background?.rotation ?? 0} bgSize={background?.scale ? background.scale*2*100 : 200}>
	{genre && (
		<p class="text-xl text-white text-center">{genre}</p>
	)}
	{photo && (
		<div class="w-full aspect-video mb-4">
			<img src={photo.src} alt={photo.alt} class="mb-4 w-full object-cover" />
		</div>
	)}
	{ albums &&
		<div class="grid grid-cols-2 gap-2">
			{albums.map((album) => (
				<a href={album.href} target="_blank" rel="noopener noreferrer" class="mb-4">
					<img src={album.src} alt={album.name} class="w-full h-full object-cover" />
				</a>
			))}
		</div>
	}
	<article class="prose">
		<Content />
	</article>
	{links && links.length > 0 && (
		<ul class="mt-4 text-white">
			{links.map((link, index) => (
				<li>
					<a href={link.href} class="hover:underline" target="_blank" rel="noopener noreferrer">
						{link.name}
					</a>
				</li>
			))}
		</ul>
	)}
</Layout>
