---
import Layout from '../../../layouts/Layout.astro';
import GridCard from '../../../components/GridCard.astro';

import type { GetStaticPaths } from "astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

export const getStaticPaths: GetStaticPaths = async () => {
	const allBios = await getCollection("bios");

	return allBios.map((bio) => ({
		params: {
			slug: bio.id,
		},
		props: { bio },
	}));
};

interface Props {
	bio: CollectionEntry<"bios">;
}

const { bio } = Astro.props as Props;
const { name, genre, font, color, links, albums, video, photo, background }  = bio.data;
const { Content } = await render(bio);
---

<Layout bgImage={background} bgOffsetX={background?.offsetX ?? 50} bgOffsetY={background?.offsetY ?? 0} bgRotation={background?.rotation ?? 0} bgSize={background?.scale ? background.scale*2*100 : 200}>
	<div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-8">
		<div class="order-2 lg:order-1 flex flex-col gap-4">
			{photo && (
				<div class="hidden lg:block w-full aspect-square mb-4">
					<img src={photo.src} alt={photo.alt} class="mb-4 w-full h-full object-cover" />
				</div>
			)}
			{ albums && (
				<div class="mb-4">
					<h2 class="text-2xl text-white mb-2 text-center text-outline">DISCOGRAPHY</h2>
				</div>
				
				<div class="grid grid-cols-2 gap-4">
					{albums.map((album) => (
		
						<GridCard
							title={}
							tooltip={album.name}
							image={{ src: album.src, alt: album.name }}
							href={album.href ? album.href : '#'}
							font={font}
							color={color}
							topText={true}
							rotationAmount={35}
						/>
					))}
				</div>
			)}
		</div>
		<div class="order-1 lg:order-2 flex flex-col gap-4">
			{photo && (
				<div class="block lg:hidden w-full aspect-square mb-4">
					<img src={photo.src} alt={photo.alt} class="mb-4 w-full h-full object-cover" />
				</div>
			)}
			<div>
				<h1 class={`text-4xl lg:text-6xl leading-6 lg:leading-12 ${font ? font : 'dela-gothic-one-regular'} ${color ? '' : 'text-indigo-400'} /text-outline /font-outline-2`}
				 	style={`${color && `color: ${color};`}`}
				>{name}</h1>
				{genre && (
					<p class={`ml-4 lg:-ml-4 -mt-1 lg:-mt-2 text-2xl ${font ? font : 'dela-gothic-one-regular'} ${color ? '' : 'text-indigo-400'}`}
						style={`${color && `color: ${color};`}`}
					>{genre}</p>
				)}
			</div>
			<article class="prose">
				<Content />
			</article>
			{ video && video.src && (
				<div class="w-full aspect-video mt-4 bg-white/50">
					<iframe
						src={video.src}
						title={video.alt ?? name}
						frameborder="0"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
						class="w-full h-full"
					></iframe>
				</div>
			)}
			{links && links.length > 0 && (
				<h2 class="text-2xl text-white mt-4 text-outline">{name.toUpperCase()}'S LINKS</h2>
				<ul class="text-white">
					{links.map((link, index) => (
						<li class="list-inside" style={`${color && `color: ${color};`}`}>
							☠️ <a href={link.href} class="hover:underline" target="_blank" rel="noopener noreferrer">
								{link.name}
							</a>
						</li>
					))}
				</ul>
			)}
		</div>
	</div>
</Layout>
