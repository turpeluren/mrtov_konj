---
import Layout from '../layouts/Layout.astro';
import bgImage from '../assets/bg-home.png';
import GridCard from '../components/GridCard.astro';

import { type CollectionEntry, getCollection} from "astro:content";

const allBands: CollectionEntry<"bios">[] = await getCollection("bios");

const meta = {
	description: "Artists of Мртов Коњ",
	title: "ARTISTS",
};
---

<Layout title="АРТИСТИ / ARTISTS" bgImage={bgImage} bgOffsetX={20} bgOffsetY={0} bgRotation={6} bgSize={175}>
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-8">
		{
			allBands.map(({ data, id }) => (
				<GridCard
					title={data.name}
					image={data.photo}
					href={`/artists/${id}/`}
				/>
			))
		}
	</div>
</Layout>
