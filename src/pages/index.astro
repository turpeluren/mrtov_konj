---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import ArtistCard from '../components/ArtistCard.astro';

import { type CollectionEntry, getCollection} from "astro:content";

import bgImage from '../assets/bg-news.png';

const allNews: CollectionEntry<"news">[] = await getCollection("news");
---
<script is:inline>
    // Run on body load
    document.addEventListener('DOMContentLoaded', () => {
        // Filter news that are older than todays date, at runtime, not build time
        const newsContainer = document.getElementById('newsContainer');
        var removeChildren = [];
        for (const element of newsContainer.children) {
            const newsDate = new Date(element.id);
            if (newsDate < new Date(new Date().toDateString())) {
                removeChildren.push(element);
            }
        }
        for (const element of removeChildren) {
            newsContainer.removeChild(element);
        }
        newsContainer.classList.toggle("hidden");
    });
</script>

<Layout title="МРТОВ КОЊ" hero={true} bgImage={bgImage} bgOffsetX={20} bgOffsetY={0} bgRotation={0} bgSize={125}>
    <h1 id="news" class="text-center text-2xl lg:text-4xl dela-gothic-one-regular /text-outline /font-outline-2">
        НОВОСТИ / NEWS FROM МРТОВ КОЊ
    </h1>
    <div class="flex flex-col gap-4 mt-8">
        <div id="newsContainer" class="hidden flex flex-col gap-4">
        {
            allNews.map(({ data, id }) => (
                <div id={data.date?.toDateString()}>
                    <NewsCard
                        title={data.title}
                        date={data.date}
                        description={data.description}
                        location={data.location}
                        image={data.images?.[0]}
                        href={`/news/${id}/`}
                    />
                </div>
            ))
        }
        </div>

        <h1 class="mt-16 text-center text-2xl lg:text-4xl dela-gothic-one-regular /text-outline /font-outline-2">
            SEE ALSO
        </h1>
        <!-- Extra card linking to /artists/ page -->
        <a href="/artists/" class="min-h-48 card-shadow flex flex-col items-center justify-center gap-4 mb-8" style={`background-image: url(/images/bg-vagina-corp.jpg); background-position: center 75%; background-size: cover;`}>
            <p class="text-center text-4xl dela-gothic-one-regular text-white px-2">АРТИСТИ / ARTISTS</p>
        </a>
    </div>
</Layout>